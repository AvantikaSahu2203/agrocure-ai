# Database Credentials
DB_USER=agrocure_admin
DB_PASSWORD=change_this_to_a_strong_password_1234
DB_NAME=agrocure

# Application Configuration
SECRET_KEY=generate_a_secure_random_key_using_openssl_rand_hex_32

# Production Public Address (URL)
# This will map directly to your live domain or EC2 public IP.
# Make sure to replace <your-ec2-ip-or-domain> with your actual public host.
NEXT_PUBLIC_API_URL=http://<your-ec2-ip-or-domain>/api/v1
